# Copy this file to .env.local and add your OpenAI API key.
OPENAI_API_KEY=
# Realtime speech-to-speech model.
OPENAI_REALTIME_MODEL=gpt-realtime
# Leave empty to use the engine default text model.
OPENAI_TEXT_MODEL=
# Model used to transcribe the student's speech.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

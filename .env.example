# Copy this file to .env.local and add your OpenAI API key.
OPENAI_API_KEY=
# Realtime speech-to-speech model.
OPENAI_REALTIME_MODEL=gpt-realtime
# Realtime turn-taking: semantic_high (default), semantic_medium, or server_400.
OPENAI_TURN_DETECTION=semantic_high
# Leave empty to use the engine default text model.
OPENAI_TEXT_MODEL=
# Patient dialogue model; leave empty to use gpt-5-mini (gpt-4.1-mini is faster but invented facts in eval).
OPENAI_PATIENT_MODEL=
# Model used to transcribe the student's speech.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Hosted private demo. Enable for BOTH Vercel Production and Preview environments.
MEDBOT_HOSTED=0
# Shared invitation passcode: at least 12 characters. Never prefix secrets with NEXT_PUBLIC_.
MEDBOT_ACCESS_CODE=
# Independent random signing secret: at least 32 characters. Rotation revokes all cookies.
MEDBOT_COOKIE_SECRET=
# Separate feedback-review code: at least 12 characters. Share only with the host.
MEDBOT_ADMIN_CODE=
# Required positive USD estimate cap in hosted mode, per UTC day and server instance.
MEDBOT_DAILY_USD_CAP=5
# Optional storage directory. Hosted/Vercel defaults to /tmp/medbot; overrides must be inside /tmp/.
MEDBOT_STORAGE_DIR=
# Local-only overrides (ignored for hosted/Vercel traces; hosted leaderboard is disabled).
MEDBOT_TRACE_DIR=
LEADERBOARD_FILE=
